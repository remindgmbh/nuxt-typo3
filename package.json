{
    "name": "@remindgmbh/nuxt-typo3",
    "version": "0.0.0-development",
    "author": "David Mellen <d.mellen@remind.de>",
    "license": "BSD-3-Clause",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/remindgmbh/nuxt-typo3.git"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/types.d.mts",
            "import": "./dist/module.mjs",
            "require": "./dist/module.mjs"
        }
    },
    "main": "./dist/module.mjs",
    "types": "./dist/types.d.mts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "npm run dev:prepare && nuxi dev playground",
        "dev:build": "nuxi build playground",
        "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
        "lint": "npm run lint:script && npm run lint:style",
        "lint:script": "eslint .",
        "lint:style": "stylelint \"**/*.{vue,[s]css}\"",
        "prepack": "npm run dev:prepare && nuxt-module-build build",
        "preview": "nuxi preview playground",
        "static-analysis": "npm run dev:prepare && npm run typecheck && npm run lint",
        "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
    },
    "dependencies": {
        "@nuxt/kit": "^4.6.0",
        "@remindgmbh/nuxt-logger": "^1.1.1",
        "defu": "^6.1.4",
        "filesize": "^11.0.0",
        "focus-trap": "^8.2.0",
        "sass": "^1.107.0",
        "scule": "^1.3.0",
        "vee-validate": "^4.15.0",
        "vue-i18n": "^11.4.0",
        "yup": "^1.7.1"
    },
    "devDependencies": {
        "@nuxt/module-builder": "^1.0.3",
        "@nuxt/schema": "^4.6.0",
        "@remindgmbh/eslint-config-nuxt": "^2.2.0",
        "@remindgmbh/stylelint-config": "^1.3.0",
        "@types/node": "^24.0.0",
        "eslint": "^10.13.0",
        "nuxt": "^4.6.0",
        "prettier": "^3.9.0",
        "stylelint": "^17.16.0",
        "typescript": "^6.0.0",
        "vue-tsc": "^3.3.0"
    },
    "overrides": {
        "typescript": "^6.0.0"
    }
}
